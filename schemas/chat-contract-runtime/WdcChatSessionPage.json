{
  "$id": "WdcChatSessionPage",
  "additionalProperties": false,
  "description": "Bounded cursor page of public WDC Chat session metadata. A required null next_cursor marks the final page.",
  "type": "object",
  "required": [
    "schema_version",
    "items",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "wdc.chat_session_page.v1",
      "type": "string"
    },
    "items": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$id": "WdcChatSession",
        "additionalProperties": false,
        "description": "Public metadata for a backend-owned WDC Chat session. Tenant, owner, authentication, governance, transcript, and action data are intentionally excluded.",
        "type": "object",
        "required": [
          "schema_version",
          "session_id",
          "title",
          "status",
          "version",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "schema_version": {
            "const": "wdc.chat_session.v1",
            "type": "string"
          },
          "session_id": {
            "minLength": 1,
            "maxLength": 200,
            "description": "Opaque backend-assigned session identifier.",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "status": {
            "$id": "WdcChatSessionStatus",
            "description": "Public lifecycle state for a backend-owned WDC Chat session.",
            "anyOf": [
              {
                "const": "active",
                "type": "string"
              },
              {
                "const": "archived",
                "type": "string"
              }
            ]
          },
          "version": {
            "minimum": 1,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        }
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
