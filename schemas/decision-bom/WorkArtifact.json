{
  "$id": "WorkArtifact",
  "description": "Signed output artifact per Deep Research Report 1 invariant I4. Verifiable end-to-end via verifyArtifact() endpoint.",
  "additionalProperties": true,
  "type": "object",
  "required": [
    "id",
    "artifact_type",
    "bom_run_id",
    "evidence_hash",
    "canonicalization_version",
    "signature_domain",
    "created_at"
  ],
  "properties": {
    "id": {
      "pattern": "^artifact-[a-zA-Z0-9-]{8,}$",
      "type": "string"
    },
    "artifact_type": {
      "$id": "WorkArtifactType",
      "anyOf": [
        {
          "const": "document",
          "type": "string"
        },
        {
          "const": "decision",
          "type": "string"
        },
        {
          "const": "deliverable",
          "type": "string"
        },
        {
          "const": "config_bundle",
          "type": "string"
        },
        {
          "const": "code_patch",
          "type": "string"
        },
        {
          "const": "report",
          "type": "string"
        },
        {
          "const": "graph_snapshot",
          "type": "string"
        },
        {
          "const": "compliance_evidence",
          "type": "string"
        },
        {
          "const": "audit_log",
          "type": "string"
        }
      ]
    },
    "bom_run_id": {
      "pattern": "^bomrun-[a-zA-Z0-9-]{8,}$",
      "type": "string"
    },
    "produced_by_bom_item_id": {
      "pattern": "^bomitem-[a-zA-Z0-9-]{8,}$",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "uri": {
      "description": "Body location (s3://, github://, graph://). Never inline body.",
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "data_class": {
      "anyOf": [
        {
          "const": "pii",
          "type": "string"
        },
        {
          "const": "confidential",
          "type": "string"
        },
        {
          "const": "public",
          "type": "string"
        },
        {
          "const": "legal",
          "type": "string"
        }
      ]
    },
    "policy_profile": {
      "type": "string"
    },
    "evidence_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Full sha256 of canonical payload (RFC 8785 JCS).",
      "type": "string"
    },
    "canonicalization_version": {
      "description": "Default: \"jcs-rfc8785-v1\".",
      "type": "string"
    },
    "signature": {
      "description": "Ed25519 signature (RFC 8032).",
      "type": "string"
    },
    "signing_pubkey_id": {
      "type": "string"
    },
    "signature_domain": {
      "description": "Default: \"widgetdc.work-artifact.v1\".",
      "type": "string"
    },
    "verification_status": {
      "$id": "WorkArtifactVerificationStatus",
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "verified",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "expired",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        }
      ]
    },
    "last_verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verifier_id": {
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "supersedes_artifact_id": {
      "pattern": "^artifact-[a-zA-Z0-9-]{8,}$",
      "type": "string"
    },
    "lineage_chain": {
      "type": "array",
      "items": {
        "pattern": "^bomitem-[a-zA-Z0-9-]{8,}$",
        "type": "string"
      }
    },
    "workflow_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "signed_at": {
      "format": "date-time",
      "type": "string"
    }
  }
}
