{
  "$id": "https://widgetdc.com/contracts/capability/CapabilityChainEdgeV1.json",
  "additionalProperties": false,
  "description": "Closed, content-addressed capability-chain edge identity. It carries no authority, provider, model, tool, or dispatch selection.",
  "type": "object",
  "required": [
    "schema_version",
    "definition_version",
    "canonicalization_profile",
    "hash_algorithm",
    "canonical_document_hash",
    "source",
    "target",
    "edge_property"
  ],
  "properties": {
    "schema_version": {
      "const": "wdc.capability_chain_edge.v1",
      "type": "string"
    },
    "definition_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "canonicalization_profile": {
      "const": "jcs-rfc8785-v1",
      "type": "string"
    },
    "hash_algorithm": {
      "const": "sha256",
      "type": "string"
    },
    "canonical_document_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 identity over the canonical contract projection, excluding this field itself.",
      "type": "string"
    },
    "source": {
      "$ref": "https://widgetdc.com/contracts/capability/CanonicalIdentityEnvelopeV1.json"
    },
    "target": {
      "$ref": "https://widgetdc.com/contracts/capability/CanonicalIdentityEnvelopeV1.json"
    },
    "edge_property": {
      "description": "Capability-only dependency relation. The v1 vocabulary is intentionally closed and additive.",
      "const": "requires",
      "type": "string"
    }
  }
}
