{
  "$id": "RoutingEvidenceStatus",
  "description": "Readback status for an Octopus routing artifact.",
  "anyOf": [
    {
      "const": "pending",
      "type": "string"
    },
    {
      "const": "artifact_ready",
      "type": "string"
