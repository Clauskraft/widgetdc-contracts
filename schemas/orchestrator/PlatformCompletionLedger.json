                "type": "string"
              },
              "lifecycle_state": {
                "anyOf": [
                  {
                    "const": "verified",
                    "type": "string"
                  },
                  {
                    "const": "adopted",
                    "type": "string"
                  }
                ]
              },
              "runtime_proof_claimed": {
                "description": "True only when runtime proof has been observed for this entry.",
                "type": "boolean"
              },
              "claim_promotion_eligible": {
                "description": "True only when the entry satisfies the claim-promotion gate.",
                "type": "boolean"
              }
            }
          }
        ]
      }
    }
  }
}
