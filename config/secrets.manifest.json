{
  "$id": "widgetdc-contracts-secrets-manifest",
  "$schema": "https://widgetdc.ai/schemas/secrets-manifest.v1.json",
  "schema_version": "2026-05-27.v1",
  "owner_repo": "Clauskraft/widgetdc-contracts",
  "purpose": "Env-name-only rotation manifest for WidgeTDC provider, runtime, CI, and operator credentials.",
  "claim_impact": "no_claim_promotion",
  "secret_policy": {
    "values_in_repo": false,
    "values_in_logs": false,
    "metadata_only": true,
    "wallet_source_of_truth": "1Password recommended; provider dashboard remains authoritative for revocation."
  },
  "wallets": [
    {
      "name": "WidgeTDC-Recovery",
      "purpose": "Human-only recovery material, break-glass notes, and provider account recovery."
    },
    {
      "name": "WidgeTDC-Prod-Secrets",
      "purpose": "Production runtime provider keys and service credentials."
    },
    {
      "name": "WidgeTDC-CI-Secrets",
      "purpose": "GitHub Actions, smoke-test, and deployment automation credentials."
    },
    {
      "name": "WidgeTDC-Dev-Secrets",
      "purpose": "Local and non-production credentials."
    }
  ],
  "entries": [
    {
      "env_name": "OPENAI_API_KEY",
      "secret_class": "provider_runtime_key",
      "provider": "openai",
      "owner_lane": "Lane-C",
      "wallet": "WidgeTDC-Prod-Secrets",
      "rotation": {
        "cadence": "90d",
        "issue": "LIN-1391",
        "requires_provider_revocation": true,
        "revocation_auth_env_name": "OPENAI_ADMIN_KEY"
      },
      "destinations": [
        {
          "type": "railway_service",
          "repo": "Clauskraft/widgetdc-openwebui",
          "service": "open-webui",
          "variable_name": "OPENAI_API_KEY"
        },
        {
          "type": "railway_service",
          "repo": "Clauskraft/WidgeTDC",
          "service": "backend",
          "variable_name": "OPENAI_API_KEY"
        },
        {
          "type": "railway_service",
          "repo": "Clauskraft/WidgeTDC",
          "service": "llm-proxy",
          "variable_name": "OPENAI_API_KEY"
        },
        {
          "type": "railway_service",
          "repo": "Clauskraft/WidgeTDC",
          "service": "wonder-agent",
          "variable_name": "OPENAI_API_KEY"
        }
      ],
      "verification": [
        "railway_env_name_readback",
        "service_health",
        "strict_openwebui_smoke",
        "llm_proxy_functional_post",
        "provider_dashboard_revocation_metadata"
      ]
    },
    {
      "env_name": "OPENAI_ADMIN_KEY",
      "secret_class": "provider_admin_key",
      "provider": "openai",
      "owner_lane": "operator",
      "wallet": "WidgeTDC-Recovery",
      "rotation": {
        "cadence": "on_use_or_owner_change",
        "issue": "LIN-1391",
        "requires_provider_revocation": false
      },
      "destinations": [
        {
          "type": "operator_env",
          "scope": "local_only",
          "variable_name": "OPENAI_ADMIN_KEY"
        }
      ],
      "verification": [
        "local_env_presence_only",
        "openai_admin_api_metadata_only"
      ]
    },
    {
      "env_name": "OPENWEBUI_BEARER_TOKEN",
      "secret_class": "strict_smoke_token",
      "provider": "openwebui",
      "owner_lane": "Lane-C",
      "wallet": "WidgeTDC-CI-Secrets",
      "rotation": {
        "cadence": "90d",
        "issue": "LIN-1338",
        "requires_provider_revocation": false
      },
      "destinations": [
        {
          "type": "github_actions",
          "repo": "Clauskraft/widgetdc-openwebui",
          "secret_name": "OPENWEBUI_BEARER_TOKEN"
        }
      ],
      "verification": [
        "github_secret_metadata",
        "strict_openwebui_smoke"
      ]
    },
    {
      "env_name": "LINEAR_API_KEY",
      "secret_class": "coordination_api_key",
      "provider": "linear",
      "owner_lane": "operator",
      "wallet": "WidgeTDC-CI-Secrets",
      "rotation": {
        "cadence": "post_go_live_or_immediate_if_exposed",
        "issue": "LIN-1154",
        "requires_provider_revocation": true
      },
      "destinations": [
        {
          "type": "operator_env",
          "scope": "local_or_ci",
          "variable_name": "LINEAR_API_KEY"
        }
      ],
      "verification": [
        "provider_dashboard_revocation_metadata",
        "filename_only_pattern_scan"
      ]
    },
    {
      "env_name": "BACKEND_API_KEY",
      "secret_class": "backend_route_auth",
      "provider": "widgetdc",
      "owner_lane": "Lane-C",
      "wallet": "WidgeTDC-CI-Secrets",
      "rotation": {
        "cadence": "90d",
        "issue": null,
        "requires_provider_revocation": false
      },
      "destinations": [
        {
          "type": "operator_env",
          "scope": "local_or_ci",
          "variable_name": "BACKEND_API_KEY"
        }
      ],
      "verification": [
        "local_env_presence_only",
        "backend_health_route_metadata"
      ]
    },
    {
      "env_name": "RAILWAY_TOKEN",
      "secret_class": "deployment_platform_token",
      "provider": "railway",
      "owner_lane": "operator",
      "wallet": "WidgeTDC-Recovery",
      "rotation": {
        "cadence": "90d_or_owner_change",
        "issue": null,
        "requires_provider_revocation": true
      },
      "destinations": [
        {
          "type": "operator_env",
          "scope": "local_or_ci",
          "variable_name": "RAILWAY_TOKEN"
        }
      ],
      "verification": [
        "local_env_presence_only",
        "railway_metadata_only"
      ]
    }
  ]
}
